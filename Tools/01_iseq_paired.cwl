#!/usr/bin/env cwl-runner
cwlVersion: v1.2
class: CommandLineTool
label: "iseq"
doc: "iseq (single-end) for sample data level"

requirements:
  ShellCommandRequirement: {}
  NetworkAccess:
    networkAccess: true

arguments:
  - shellQuote: false
    valueFrom: |
      iseq --input $(inputs.accession) --gzip --fastq --threads $(inputs.threads) --parallel $(inputs.parallel_number) || true

inputs:
  - id: accession
    type: string
    label: "accession"
    doc: "accession"
    default: "GSE253874"

  - id: threads
    type: int
    label: "threads"
    doc: "threads"
    default: 16

  - id: parallel_number
    type: int
    label: "parallel_number"
    doc: "parallel_number"
    default: 8


outputs:
  # Define an output for the compressed FASTQ files
  fastq_gz_file_1:
    type: File
    label: "Compressed FASTQ file 1"
    doc: "Compressed FASTQ file generated by iseq."
    outputBinding:
      glob: "SRR*_1.fastq.gz" # Use glob to capture all files matching the pattern SRR*.fastq.gz

  fastq_gz_file_2:
    type: File
    label: "Compressed FASTQ file 2"
    doc: "Compressed FASTQ file generated by iseq."
    outputBinding:
      glob: "SRR*_2.fastq.gz" # Use glob to capture all files matching the pattern SRR*.fastq.gz

  # Optionally, define outputs for log files if they are consistently produced and needed
  success_log:
    type: File? # Use '?' to indicate the file might not always exist
    outputBinding:
      glob: "success.log"
    label: "Success log file"
    doc: "Log file indicating successful runs."

  fail_log:
    type: File? # Use '?' to indicate the file might not always exist
    outputBinding:
      glob: "fail.log"
    label: "Failure log file"
    doc: "Log file indicating failed runs."

hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/iseq:1.9.1--hdfd78af_0

$namespaces:
  s: https://schema.org/
  edam: https://edamontology.org/